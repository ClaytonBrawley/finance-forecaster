# Copy this file to .env and adjust as needed. Never commit the real .env.
# Points at a database named finance_forecaster on a local SQL Server-compatible
# instance (e.g. the uber-genius-sql Azure SQL Edge container on localhost:1433).
DATABASE_URL="sqlserver://localhost:1433;database=finance_forecaster;user=sa;password=CHANGE_ME;trustServerCertificate=true"
PORT=4000
